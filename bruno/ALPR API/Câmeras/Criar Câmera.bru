meta {
  name: Criar Câmera
  type: http
  seq: 1
}

post {
  url: {{base_url}}/cameras
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "{{camera_nome}}",
    "chave_hash": "{{camera_chave_hash}}",
    "direcao": "entrada"
  }
}
