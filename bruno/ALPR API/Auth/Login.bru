meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{admin_username}}",
    "senha": "{{admin_senha}}"
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.access_token) {
    bru.setEnvVar("access_token", body.access_token, { persist: true });
  }

  if (body?.refresh_token) {
    bru.setEnvVar("refresh_token", body.refresh_token, { persist: true });
  }
}
