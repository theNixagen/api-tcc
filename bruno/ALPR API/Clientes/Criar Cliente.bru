meta {
  name: Criar Cliente
  type: http
  seq: 1
}

post {
  url: {{base_url}}/clientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "{{cliente_nome}}",
    "chave_hash": "{{cliente_chave_hash}}"
  }
}
