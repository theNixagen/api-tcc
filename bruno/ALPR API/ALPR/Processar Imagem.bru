meta {
  name: Processar Imagem
  type: http
  seq: 1
}

post {
  url: {{base_url}}/alpr
  body: multipartForm
  auth: none
}

headers {
  X-Cliente-Secret: {{cliente_secret}}
}

body:multipart-form {
  imagem: @file(/home/joao/workspace/github.com/theNixagen/script-tcc/imagens/crv.jpeg) @contentType(image/jpeg)
}
