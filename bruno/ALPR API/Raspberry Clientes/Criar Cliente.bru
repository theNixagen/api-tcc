meta {
  name: Criar Cliente
  type: http
  seq: 1
}

post {
  url: {{base_url}}/raspberry-clientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "{{raspberry_nome}}",
    "chave_hash": "{{raspberry_chave_hash}}"
  }
}
